# Node.js
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.npm
**/.yarn-integrity

# Next.js
**/.next/
**/out/
**/.vercel/

# Build outputs
**/dist/
**/build/
**/*.tgz

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
**/.vscode/
**/.idea/
**/*.swp
**/*.swo
**/*~

# OS generated files
**/.DS_Store
**/.DS_Store?
**/._*
**/.Spotlight-V100
**/.Trashes
**/ehthumbs.db
**/Thumbs.db

# Git
**/.git/
**/.gitignore

# Electron specific
**/app/
**/release/
**/*.dmg
**/*.exe
**/*.AppImage

# Logs
**/logs/
**/*.log

# Runtime data
**/pids/
**/*.pid
**/*.seed
**/*.pid.lock

# Coverage directory used by tools like istanbul
**/coverage/
**/*.lcov

# Cache directories
**/.cache/
**/.eslintcache
**/.stylelintcache

# Temporary folders
**/tmp/
**/temp/

# Docker files (avoid recursive copying)
**/Dockerfile*
**/docker-compose*.yml
**/.dockerignore

# Documentation
**/README.md
**/*.md
**/docs/

# Testing
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts

# Package manager lock files (optional - you might want to keep these)
# package-lock.json
# yarn.lock

# Development only dependencies
**/scripts/
**/tools/
