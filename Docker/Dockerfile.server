# Use Ubuntu 18.04 as the base image
FROM ubuntu:18.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies including timezone data and build tools
RUN apt-get update && apt-get install -y --fix-missing \
    bash \
    vim \
    curl \
    qt5-default \
    nodejs \
    libcairo2 \
    libgomp1 \
    bzr \
    libxss1 \
    libgnomecanvas2-0 \
    libxmu6 \
    wget \
    libssl1.0.0 \
    libmariadbclient-dev \
    build-essential \
    tcsh \
    tzdata \
    python3-pip \
    python3-dev \
    gcc \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install libpng12
WORKDIR /tmp
RUN wget http://se.archive.ubuntu.com/ubuntu/pool/main/libp/libpng/libpng12-0_1.2.54-1ubuntu1_amd64.deb && \
    dpkg -i libpng12-0_1.2.54-1ubuntu1_amd64.deb && \
    rm libpng12-0_1.2.54-1ubuntu1_amd64.deb

# Set timezone explicitly
ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Set work directory
WORKDIR /usr/src/app

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Copy requirements.txt first for better layer caching
COPY requirements.txt ./

# Copy application code
COPY . ./

# Create directories that might be needed
RUN mkdir -p /usr/src/app/staticfiles /usr/src/app/media /tmp

# Make sure the app directory is writable for static files collection
RUN chmod 755 /usr/src/app

EXPOSE 8000

# Health check using system python initially, will switch to CCP4 python after setup
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

# Default command - will be overridden by docker-compose
CMD ["python3", "manage.py", "runserver", "0.0.0.0:8000"]
