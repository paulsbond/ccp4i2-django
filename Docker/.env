# Database Configuration
DB_NAME=ccp4i2
DB_USER=ccp4i2
DB_PASSWORD=ccp4i2_secure_password
DB_PORT=5432

# Django Configuration
DEBUG=false
DJANGO_SECRET_KEY=your-very-secure-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,nginx,web,server
CORS_ALLOWED_ORIGINS=http://localhost:3003,http://web:3003,http://nginx

# Application Ports
SERVER_PORT=8000
WEB_PORT=3003
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Uvicorn Configuration
UVICORN_WORKERS=2
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Environment
ENVIRONMENT=development
NODE_ENV=production

# CCP4 Data Path
CCP4_DATA_HOST_PATH=/home/local/GPU4/noble/software/for-ccp4x

# Database URL
DATABASE_URL=postgresql://ccp4i2:ccp4i2_secure_password@db:5432/ccp4i2

