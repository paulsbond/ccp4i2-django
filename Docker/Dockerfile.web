FROM node:20-alpine3.20 AS builder

WORKDIR /app

# Copy package files - now relative to client directory context
COPY package*.json ./

# Install all dependencies (including devDependencies for building)
RUN npm ci

# Copy client source code - now copies everything from client directory
COPY . .

# Build for web
RUN npm run build:web

FROM node:20-alpine3.20 AS runner

WORKDIR /app

# Copy built application
COPY --from=builder /app/renderer/.next ./renderer/.next
COPY --from=builder /app/renderer/public ./renderer/public
COPY --from=builder /app/package*.json ./

# Install all dependencies (including cross-env which is needed for start:web)
RUN npm ci && npm cache clean --force

EXPOSE 3000

# Start the web application
CMD ["npm", "run", "start:web"]
